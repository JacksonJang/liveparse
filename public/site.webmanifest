{
  "name": "LiveParse",
  "short_name": "LiveParse",
  "description": "Private, browser-based developer tools for JSON, YAML, XML, SQL, URLs, timestamps, dates, images, Base64, hashes, UUIDs, and JWTs.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#087487",
  "lang": "en",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
